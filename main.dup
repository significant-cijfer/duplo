extern fn echo() i32;
extern fn putchar(c: i32) void;

extern fn boxInt(x: i32) &i32;
extern fn boxPrint(p: &i32) void;


let Uint8Array: type = struct {
    byte: u8,
    next: Uint8Array,
};

extern fn createUint8Array(n: i32) &Uint8Array;

fn meaning() i32, {
    return 42;
};

fn inc(x: i32) i32, {
    return x + 1;
};

fn f(x: i32) i32, {
    let y: i32 = x * 2;

    return x + y;
};

fn ggez(x: u8) u8, {
    return x * 10;
};

fn main() u8, {
    let x: u8 = if 1, 7 else 9;

    let bint: &i32 = boxInt(10);
    *bint = 20;
    boxPrint(bint);

    let lint: i32 = 30;
    boxPrint(&lint);

    putchar(65);

    let arr: &Uint8Array = createUint8Array(16);

    return if 1, { return ggez(1); } else ggez(6) + x;
};

