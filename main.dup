fn inc(x: i32) i32, {
    return x + 1;
};

fn f(x: i32) i32, {
    let y: i32 = x * 2;

    return x + y;
};

fn ggez(x: u8) u8, {
    return x * 10;
};

fn main() u8, {
    let x: u8 = if 1, 7 else 9;

    return if 1, { return ggez(1); } else ggez(6) + x;
};

